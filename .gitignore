# Ukázkový .gitignore pro tento projekt.
# Syntaxe: "*" je zástupný znak, "/" na konci značí složku,
# "!" je výjimka z pravidla a "#" je komentář.

# --- Tajné klíče a lokální konfigurace ---
.env
.env.*
!.env.example

# --- Logy ---
*.log

# --- Python ---
__pycache__/
*.pyc
.venv/
venv/

# --- Node.js ---
node_modules/

# --- Výstupy buildu ---
build/
dist/

# --- Editory a systém ---
.vscode/
.idea/
.DS_Store
Thumbs.db
